# Postgres. Local: docker compose (below). Neon: `neon env pull` writes both URLs into .env.local,
# which overrides this file. Delete/rename .env.local to go back to the local Docker database.
# App traffic uses the pooled URL (-pooler host); migrate/seed/codegen prefer the direct one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sharad_utsav
# DATABASE_URL_UNPOOLED=   # Neon direct (non -pooler) URL, used by db scripts when set

# Stripe (test mode only — never commit real keys)
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Local: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=replace_me_with_a_long_random_string
